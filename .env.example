# Copy to .env and adjust. .env itself is gitignored — never commit real secrets.

MYSQL_ROOT_PASSWORD=changeme

# TrinityCore application DB user. Used to create the user (deploy/mysql/01-init-users.sh)
# AND to render the LoginDatabaseInfo/WorldDatabaseInfo/CharacterDatabaseInfo connection
# strings in deploy/*.conf at container start (docker/scripts/render-conf-and-run.sh) —
# change these here, not in deploy/*.conf, so both stay in sync.
TC_DB_USER=trinity
TC_DB_PASSWORD=trinity

WORLDSERVER_PORT=8085
AUTHSERVER_PORT=3724
# mysql (3306) and ai-server (8000) are intentionally not published to the
# host — only worldserver/authserver need them, over the internal Compose
# network. Add a `ports:` entry in compose.yml yourself if you need to reach
# either from outside the stack during development.

# Optional bearer token for ai-server's /dynamic-task local-model provider
# (docker/ai/app/model_provider.py) — only needed if your configured
# AI_TASK_MODEL_URL backend actually requires one. Leave empty otherwise.
# Never logged. See compose.yml's own AI_TASK_MODEL_* block for the rest of
# that provider's configuration (all default safely without a .env entry).
AI_TASK_MODEL_API_KEY=

# Tri-state thinking control for the same provider — 0/1 sends
# chat_template_kwargs.enable_thinking=false/true explicitly; only
# meaningful for a backend that actually understands that llama.cpp-style
# parameter. Defaults to 0 here and in compose.yml for 2.13A3B
# development, since the model this phase is validated against is a
# reasoning model whose chain-of-thought must stay off for the provider's
# own SYSTEM_PROMPT/max_tokens budget to work reliably. Leaving this
# value empty does NOT get you "omit the parameter entirely" - both
# compose.yml's own AI_TASK_MODEL_ENABLE_THINKING fallback and
# model_provider.py's own from_env() default to "0" now, so an empty/
# absent .env value still resolves to 0. Getting the true tri-state
# "send nothing backend-specific at all" behavior back requires editing
# compose.yml's own default directly.
AI_TASK_MODEL_ENABLE_THINKING=0

# Host path to extracted 3.3.5a client data (dbc/maps/vmaps/mmaps).
# See README_DEV.md "WoW game data" for the extraction steps.
WOW_DATA_DIR=./runtime/data

# Docker dev-user UID/GID, matched to the host user (see docker/trinitycore/Dockerfile.dev).
DEV_UID=1000
DEV_GID=1000

# auth.realmlist entry advertised to game clients — the address/port a
# client uses to reach worldserver after authenticating against authserver.
# Applied via `make configure-realm` (docker/scripts/configure-realm.sh)
# instead of a manual `UPDATE realmlist` against the DB. REALM_PORT should
# match WORLDSERVER_PORT above. Defaults below are this dev box's LAN IP —
# use 127.0.0.1 for a single-machine setup, or your own host's LAN IP.
REALM_NAME=AI World
REALM_ADDRESS=192.168.0.248
REALM_LOCAL_ADDRESS=192.168.0.248
REALM_LOCAL_SUBNET_MASK=255.255.255.0
REALM_PORT=8085

# account-web (docker/account-web) — a small form that creates WoW accounts
# via worldserver's SOAP console instead of writing to `auth` directly. The
# account named here must already exist with SEC_ADMINISTRATOR on this
# realm; TrinityCore's SOAP handler requires that for every command,
# account-web's own account-creation calls included. See README_DEV.md
# "Account creation web UI" for the one-time bootstrap of this account.
TC_SOAP_USER=
TC_SOAP_PASSWORD=
ACCOUNT_WEB_PORT=8088
