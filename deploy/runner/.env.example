# Copy to .env in this directory and fill in. .env is gitignored — never
# commit real secrets.

GH_RUNNER_REPO_URL=https://github.com/LoubekJan/WoWBehaviorAI

# Fine-grained personal access token, repo-scoped, with "Administration:
# read & write" so the runner container can self-register and renew its
# registration token on restart (registration tokens alone expire in 1h).
# Rotate periodically; revoke immediately if the deploy host is ever
# suspected compromised.
GH_RUNNER_PAT=

GH_RUNNER_NAME=wow-deploy-runner
